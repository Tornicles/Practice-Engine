{
  "expo": {
    "name": "Startup Man",
    "slug": "practice-engine-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "practice-engine-mobile",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0f1215",
      "resizeMode": "contain",
      "image": "./assets/images/icon-generated.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.practiceengine.mobile"
    },
    "android": {
      "package": "com.practiceengine.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-generated.png",
        "backgroundColor": "#0f1215"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "@clerk/expo",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
