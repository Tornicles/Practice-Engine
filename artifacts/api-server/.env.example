# Copy to .env and fill in. Never commit .env.
# Required: Postgres connection string (lib/db throws at boot without it)
DATABASE_URL=postgresql://user:password@localhost:5432/practice_engine

# Required: Clerk auth
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Required: OpenAI via Replit AI integrations
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Optional: webhook for intelligence alerts
INTELLIGENCE_ALERT_WEBHOOK_URL=

# Optional
LOG_LEVEL=info
PORT=3000
